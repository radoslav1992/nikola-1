{
  "name": "ni-imoti",
  "version": "1.0.0",
  "private": true,
  "description": "НИ Имоти — сайт на брокер Никола Иванов (niimoti.com). Cloudflare Worker + static assets.",
  "type": "module",
  "scripts": {
    "build": "npm run build:client && npm test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "seed": "node scripts/build-seed.mjs",
    "cf-typegen": "wrangler types",
    "dev:offline": "node -e \"const fs=require('fs');fs.writeFileSync('wrangler.local.jsonc',fs.readFileSync('wrangler.jsonc','utf8').replace(/\\\"ai\\\": \\{[^}]*\\},/,''))\" && wrangler dev -c wrangler.local.jsonc",
    "build:client": "esbuild src/client/assistant.js --bundle --minify --format=iife --target=es2022 --outfile=public/assistant.js"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24.15"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.25.0"
  }
}
